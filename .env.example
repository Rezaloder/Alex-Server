# ============================================================
#  Alex Server — configuration
#  cp .env.example .env  &&  nano .env
#  .env holds secrets: never commit it (it is in .gitignore).
# ============================================================

# --- Domain & identity ---------------------------------------
# Domain whose A record points to this server. Used for the panel
# HTTPS certificate (Let's Encrypt, needs TCP 80 reachable once).
DOMAIN=vpn.example.com
ACME_EMAIL=admin@example.com

# Address written into client configs (VLESS / WireGuard).
# Leave empty to use DOMAIN. Put the server IP or a neutral second
# domain here if you don't want your main domain visible in configs.
SHARE_ADDR=

# Name users see in their app (keep it neutral).
INBOUND_REMARK=Server

# --- SSH -----------------------------------------------------
# The port sshd ALREADY listens on. The firewall keeps it open.
# The installer refuses to continue if sshd is not on this port.
SSH_PORT=22

# --- 3x-ui panel ---------------------------------------------
PANEL_PORT=52667
PANEL_USER=admin
PANEL_PASS=change-me-to-a-long-password
# Secret URL path of the panel. Empty = random (recommended).
PANEL_PATH=
SUB_PORT=2096

# --- VLESS + Reality -----------------------------------------
VLESS_PORT=443
# A FAST domestic HTTPS site (TLS 1.3 + h2) reachable from the server.
# Do not use a foreign CDN site: every connection waits on it.
REALITY_TARGET=www.digikala.com
CLIENT_DNS=1.1.1.1

# --- L2TP/IPsec ----------------------------------------------
L2TP_PSK=change-me-long-random-psk
L2TP_NET=10.203.62

# --- WireGuard for users -------------------------------------
WG_PORT=51820
WG_NET=10.203.61

# --- Egress tunnel -------------------------------------------
# All user traffic leaves through this WireGuard tunnel to your
# foreign router/server (e.g. a MikroTik that forwards to Windscribe).
# Leave EGRESS_PEER_PUBKEY empty on the first run: the installer
# prints THIS server's public key for the other side, then re-run.
EGRESS_ENDPOINT=198.51.100.20:51830
EGRESS_PEER_PUBKEY=
EGRESS_ADDRESS=10.203.70.2/30
EGRESS_MTU=1420

# --- Pinned versions (do not use pre-releases) ---------------
XUI_VERSION=v3.10.2
XRAY_VERSION=v26.3.27

# Answer ping (ICMP echo). Handy for troubleshooting.
ALLOW_PING=yes
